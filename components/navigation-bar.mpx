<template>
    <view>
        <view wx:if="{{borderOnly}}" style="width: 100%; border-top: 1px #cfd6e3 solid; position: fixed; z-index: 999"></view>
        <view wx:else class="nav-bar" style="height:{{navBarHeight}}px;width:100%;">
            <view style="position: absolute; width: 100%; height: 100%; background: {{bgColor}}; z-index: -1; opacity:{{renderOpacity}}"></view>
            <view
                class="capsule"
                style="display:flex;align-items:center;height:{{capsuleHeight}}px;width:100%;margin-bottom:{{capsuleBottom}}px;line-height:{{capsuleHeight}}px;"
            >
                <!-- 左侧区域：支持slot自定义或使用默认布局（返回按钮+标题） -->
                <view class="nav-bar-left" style="display: flex; align-items: center; {{ useCustomCenter ? 'width: 80px; flex-shrink: 0;' : 'flex: 1; min-width: 0;' }}">
                    <!-- 自定义左侧内容 -->
                    <slot name="left" wx:if="{{ useCustomLeft }}"></slot>

                    <!-- 默认左侧内容（返回按钮 + 标题） -->
                    <view wx:else style="display: flex; align-items: center; {{ useCustomCenter ? '' : 'flex: 1; min-width: 0;' }}">
                        <!-- 返回按钮 -->
                        <van-icon
                            wx:if="{{backBtn && !hideBackButton}}"
                            name="arrow-left"
                            size="24px"
                            color="{{titleColor}}"
                            custom-style="padding-left: 6px; width: 15px; height: 34px; padding-right: 14px;display:flex;align-items:center"
                            bindtap="navigateBack"
                        />
                        <view wx:else style="padding-left: 16px"></view>

                        <!-- 标题（紧跟返回按钮） -->
                        <view wx:if="{{ !useCustomCenter }}" style="display: flex; align-items: center; flex: 1; min-width: 0;">
                            <van-image wx:if="{{titleIcon !== ''}}" fit="heightFix" height="{{capsuleHeight}}" src="{{titleIcon}}" style="flex-shrink: 0;" />
                            <view style="color: {{titleColor}};font-size:{{titleSize}}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0;">
                                {{ title }}
                            </view>
                        </view>
                    </view>
                </view>

                <!-- 中间区域：仅用于自定义内容，默认为空 -->
                <view class="nav-bar-center" style="display: flex; align-items: center; justify-content: center; {{ useCustomCenter ? 'flex: 1;' : 'flex: 0;' }}">
                    <!-- 自定义中间内容 -->
                    <slot name="center" wx:if="{{ useCustomCenter }}"></slot>
                </view>

                <!-- 右侧区域：为小程序菜单预留空间，不放置任何内容 -->
                <view class="nav-bar-right" style="{{ useCustomCenter ? 'width: 80px; flex-shrink: 0;' : 'min-width: 80px;' }}"></view>
            </view>
        </view>
        <view wx:if="{{useHolder}}" style="height:{{navBarHeight}}px;width:100%;"></view>
    </view>
</template>

<script lang="ts">
    import { computed, createComponent, ref, toRefs } from '@mpxjs/core'
    import { storeToRefs } from '@mpxjs/pinia'

    import { useHperStore } from '../store/helper'

    createComponent({
      options:{
        multipleSlots: true
      },
        properties: {
            // 开始渐变的高度
            startFade: {
                type: Number,
                value: 0
            },
            // 是否启用占位
            useHolder: {
                type: Boolean,
                value: true
            },
            // 渐变高度过渡值
            fadeHeight: {
                type: Number,
                value: 50
            },

            title: {
                type: String,
                value: ''
            },

            titleSize: {
                type: String,
                value: '17.5px'
            },

            titleColor: {
                type: String,
                value: '#ffffff'
            },

            titleAlign: {
                type: String,
                value: 'center' // left center
            },

            // 背景颜色
            bgColor: {
                type: String,
                value: '#000000'
            },
            // 初始透明度
            opacity: {
                type: Number,
                value: 1
            },
            borderOnly: {
                type: Boolean,
                value: false
            },

            titleIcon: {
                type: String,
                value: ''
            },

            // 是否隐藏默认返回按钮（当使用左侧slot时）
            hideBackButton: {
                type: Boolean,
                value: false
            },

            // 是否使用自定义左侧内容
            useCustomLeft: {
                type: Boolean,
                value: false
            },

            // 是否使用自定义中间内容
            useCustomCenter: {
                type: Boolean,
                value: false
            },

            // 是否点击返回时直接回首页
            backHome: {
                type: Boolean,
                value: false
            },

            // 是否在栈底也显示返回按钮（reLaunch 进入详情页等场景，点击回首页）
            alwaysShowBack: {
                type: Boolean,
                value: false
            }
        },
        setup(props) {
            const appStore = useHperStore()
            const { startFade, fadeHeight, opacity } = toRefs(props)
            const renderOpacity = ref(opacity.value)

            const setPageScrollTop = (scrollTop: number) => {
                if (scrollTop > startFade.value) {
                    renderOpacity.value = (scrollTop - startFade.value) / fadeHeight.value
                } else {
                    renderOpacity.value = 0
                }
            }

            const backBtn = computed(() => {
                // alwaysShowBack 时栈底也显示（reLaunch 进入详情页，点击回首页）
                return (props as any).alwaysShowBack || getCurrentPages().length > 1
            })

            const navigateBack = () => {
                if ((props as any).backHome) {
                    wx.switchTab({
                        url: '/pages/index',
                        fail() {
                            wx.reLaunch({
                                url: '/pages/index'
                            })
                        }
                    })
                    return
                }

                // 栈底（reLaunch/redirectTo 进入详情等场景）时返回首页，避免直接退出小程序
                if (getCurrentPages().length <= 1) {
                    wx.switchTab({
                        url: '/pages/index',
                        fail() {
                            wx.reLaunch({
                                url: '/pages/index'
                            })
                        }
                    })
                    return
                }

                wx.navigateBack()
            }

            return { ...storeToRefs(appStore), setPageScrollTop, renderOpacity, navigateBack, backBtn }
        }
    })
</script>

<style lang="stylus">
    .nav-bar
        position fixed
        z-index 999
        display flex
        justify-content space-between
        align-items flex-end
        width 100%
        top 0
        left 0
        right 0
    .capsule
        display flex
        align-items center
    .nav-bar-left
        display flex
        align-items center
        justify-content flex-start
    .nav-bar-center
        display flex
        align-items center
        justify-content center
        flex 1
    .nav-bar-right
        // 预留给小程序菜单的空间
        min-width 80px
</style>

<script type="application/json">
    {
        "component": true,
        "usingComponents": {
            "van-icon": "@vant/weapp/icon/index",
            "van-image": "@vant/weapp/image/index"
        }
    }
</script>
